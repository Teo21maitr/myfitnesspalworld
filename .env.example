# =============================================================================
# MyFitnessPalworld — variables d'environnement
# =============================================================================
# Copier ce fichier vers `.env` puis renseigner les valeurs locales.
# Ce fichier ne doit JAMAIS contenir de valeur secrète réelle.
#
# Le `.env` de la racine est utilisé par docker compose ET par le backend
# Django lancé hors Docker. Le frontend a son propre `frontend/.env`
# (Vite ne lit que les fichiers d'environnement de sa propre racine).
# =============================================================================

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# config.settings.local | config.settings.production | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.local
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=changeme-dev-only-never-use-in-production
DJANGO_DEBUG=True
# Liste séparée par des virgules. Obligatoire en production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Nom du service / version applicative exposée par /health/
APP_VERSION=0.1.0

# -----------------------------------------------------------------------------
# Base de données PostgreSQL
# -----------------------------------------------------------------------------
# Valeur vue depuis l'hôte (docker compose publie Postgres sur POSTGRES_PORT).
# Les conteneurs backend/worker/beat reçoivent automatiquement `db:5432` via
# docker-compose.yml : cette valeur n'est utilisée que hors Docker.
DATABASE_URL=postgres://mfp:mfp@localhost:5433/mfp
# Utilisées uniquement par le service `db` de docker compose
POSTGRES_USER=mfp
POSTGRES_PASSWORD=mfp
POSTGRES_DB=mfp

# -----------------------------------------------------------------------------
# Redis / Celery
# -----------------------------------------------------------------------------
# Valeurs vues depuis l'hôte. Les conteneurs reçoivent `redis:6379`.
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# -----------------------------------------------------------------------------
# URLs publiques
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# CORS / CSRF
# -----------------------------------------------------------------------------
# Allowlist stricte, séparée par des virgules. Jamais "*" en production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8001

# -----------------------------------------------------------------------------
# Cookies d'authentification (access/refresh JWT en HttpOnly)
# -----------------------------------------------------------------------------
AUTH_COOKIE_SECURE=False
# Lax en local (même site), None en production si le frontend et l'API sont
# sur des sous-domaines différents (impose AUTH_COOKIE_SECURE=True).
AUTH_COOKIE_SAMESITE=Lax
# Laisser vide en local. Exemple production : .example.com
AUTH_COOKIE_DOMAIN=
# Le cookie de refresh est restreint aux routes d'authentification : il ne
# circule pas à chaque appel d'API.
AUTH_COOKIE_REFRESH_PATH=/api/v1/auth/

# -----------------------------------------------------------------------------
# Open Food Facts (spec 11 §3)
# -----------------------------------------------------------------------------
# Coupe-circuit : à False, la recherche locale, Ciqual et les aliments
# personnels continuent de fonctionner normalement.
OFF_ENABLED=True
OFF_PRODUCT_URL=https://world.openfoodfacts.org
# L'endpoint de recherche historique (/api/v2/search) est hors service : la
# recherche texte passe par Search-a-licious.
OFF_SEARCH_URL=https://search.openfoodfacts.org
# Open Food Facts exige un User-Agent identifiant l'application et un contact,
# sous la forme NomApp/Version (email). Renseigner une adresse réelle.
OFF_CONTACT_EMAIL=
OFF_USER_AGENT=
OFF_CONNECT_TIMEOUT=3.0
OFF_READ_TIMEOUT=8.0
# Quotas annoncés par Open Food Facts. Ils s'appliquent PAR ADRESSE IP : le
# backend les partage donc entre tous les comptes, d'où un budget global en
# plus du throttling par utilisateur.
OFF_PRODUCT_RATE_PER_MINUTE=15
OFF_SEARCH_RATE_PER_MINUTE=10
# Âge au-delà duquel une fiche en cache est rafraîchie en tâche de fond.
OFF_CACHE_TTL_DAYS=30

# -----------------------------------------------------------------------------
# IA (spec 07)
# -----------------------------------------------------------------------------
# Ces variables disent si l'IA est *configurée*. Le coupe-circuit administrateur
# vit en base (réglage `ai_enabled` dans l'admin Django) : une variable
# d'environnement se change en redéployant, ce qui n'est pas un interrupteur.
AI_ENABLED=False
# `anthropic` en fonctionnement réel, `fake` pour développer sans clé et pour
# rendre les parcours de test déterministes. La production refuse `fake`.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MEAL_SCAN_MODEL=claude-sonnet-5
# Lire une étiquette est une transcription, pas une reconnaissance : la tâche
# peut mériter un autre modèle. À défaut, celui du scan de repas.
AI_LABEL_SCAN_MODEL=
AI_MEAL_PLANNER_MODEL=claude-sonnet-5
AI_VOICE_PARSING_MODEL=claude-haiku-4-5
AI_RECIPE_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# Email (non utilisé par le socle, préparé pour les notifications)
# -----------------------------------------------------------------------------
# Sous Docker, docker-compose.yml bascule automatiquement sur Mailpit
# (backend SMTP) et l'interface est disponible sur http://localhost:8025.
# Hors Docker, les emails s'affichent dans la console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MyFitnessPalworld <noreply@localhost>

# Délai maximal d'un envoi, en secondes. Il borne aussi bien SMTP que l'API
# HTTP : sans lui, un fournisseur muet immobilise un worker jusqu'à ce qu'il
# soit tué, sans laisser de trace de l'échec.
EMAIL_TIMEOUT=10

# Envoi par API HTTP (Resend), seule voie praticable en production : la
# plateforme ferme les ports SMTP en sortie. En local, le backend console
# ci-dessus suffit et cette clé reste vide.
#   EMAIL_BACKEND=anymail.backends.resend.EmailBackend
RESEND_API_KEY=

# Durée de validité d'un lien de réinitialisation, en secondes (1 heure).
PASSWORD_RESET_TIMEOUT=3600

# -----------------------------------------------------------------------------
# Stockage objet S3-compatible — photos de progression (spec 05 §10)
# -----------------------------------------------------------------------------
# Le seau doit être PRIVÉ : les photos ne sont lisibles que par une URL signée
# de courte durée, jamais par une adresse permanente.
#
# En local, `docker compose up` démarre MinIO et crée le seau ; les valeurs
# ci-dessous sont celles que les conteneurs utilisent entre eux. Laissez-les
# vides pour désactiver la fonctionnalité : l'envoi d'une photo répond alors
# 503, et le reste de l'application n'en est pas affecté.
S3_ENDPOINT_URL=http://localhost:9002

# Adresse du stockage telle que le NAVIGATEUR la voit. À renseigner dès que le
# backend joint le stockage par un réseau privé — c'est le cas sous Docker, où
# le conteneur dit `http://minio:9000` et le navigateur `http://localhost:9002`.
# Vide, elle reprend `S3_ENDPOINT_URL`.
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY_ID=mfp-local
S3_SECRET_ACCESS_KEY=mfp-local-secret
S3_BUCKET_NAME=mfp-photos
S3_REGION=us-east-1

# Identifiants du MinIO local et ports publiés sur l'hôte.
MINIO_ROOT_USER=mfp-local
MINIO_ROOT_PASSWORD=mfp-local-secret
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003

# Durée de vie d'une URL signée, en secondes. Courte par principe : une URL
# émise reste valable jusqu'à son expiration, même si la photo est supprimée
# entre-temps.
PROGRESS_PHOTO_URL_TTL=300

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# -----------------------------------------------------------------------------
# Ports publiés par docker compose sur l'hôte
# -----------------------------------------------------------------------------
# Valeurs par défaut décalées des ports standards pour cohabiter avec d'autres
# projets déjà en cours d'exécution sur la machine (Postgres 5432, API 8000).
BACKEND_PORT=8001
FRONTEND_PORT=5173
POSTGRES_PORT=5433
REDIS_PORT=6380
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
