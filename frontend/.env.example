# Configuration du frontend Vite.
# Copier vers `frontend/.env`. Seules les variables préfixées `VITE_` sont
# exposées au navigateur : ne jamais y placer de secret.

# Base versionnée de l'API. Le port 8001 correspond à BACKEND_PORT du `.env`
# de la racine.
# Chemin relatif : Vite relaie `/api` vers le backend, comme nginx en
# production. Les deux environnements parlent ainsi à une seule origine.
VITE_API_BASE_URL=/api/v1
# Cible du relais. Sous Docker, le backend s'appelle `backend`.
VITE_API_PROXY_TARGET=http://localhost:8001
