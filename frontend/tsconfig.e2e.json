{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    /* Les rappels passés à `page.evaluate` et `page.addInitScript` s'exécutent
       dans le navigateur : leurs types viennent de la DOM, même si la spec,
       elle, tourne sous Node. */
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Playwright transpile lui-même les specs : la résolution « bundler »
       correspond à son comportement et évite d'imposer des extensions. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["playwright.config.ts", "e2e/**/*.ts"]
}
